{
  "name": "@poluru-labs/enterprise-design-system-react",
  "version": "1.0.0",
  "description": "Enterprise Design System — React components, design tokens, ThemeProvider, ToastProvider, and Storybook.",
  "author": {
    "name": "Subrahmanyam Poluru",
    "email": "mail.polurus@gmail.com",
    "url": "https://polurus.com"
  },
  "contributors": [
    {
      "name": "Subrahmanyam Poluru",
      "email": "mail.polurus@gmail.com",
      "url": "https://www.linkedin.com/in/polurus/"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/poluru-labs/enterprise-design-system-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poluru-labs/enterprise-design-system-react.git"
  },
  "bugs": {
    "url": "https://github.com/poluru-labs/enterprise-design-system-react/issues",
    "email": "mail.polurus@gmail.com"
  },
  "funding": {
    "type": "individual",
    "url": "https://polurus.com"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/tokens/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/tokens",
    "LICENSE",
    "AUTHORS",
    "NOTICE",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --coverage",
    "clean": "rm -rf dist storybook-static coverage *.tgz",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm run verify && npm run pack:check",
    "prepublishOnly": "npm run release:check"
  },
  "keywords": [
    "design-system",
    "enterprise-design-systems",
    "react",
    "typescript",
    "storybook",
    "tokens",
    "accessibility",
    "enterprise",
    "poluru-labs",
    "jest"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.18",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/theming": "^8.6.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.30.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
